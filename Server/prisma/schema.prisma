generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model StationaryOwner{
  id Int @id @default(autoincrement())
  ownerName String
  shopName String
  email String @unique
  phone String   @unique
  passwordHash String
  city String
  isOpen       Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}