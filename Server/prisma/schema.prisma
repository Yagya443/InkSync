generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model StationaryOwner {
  id        Int      @id @default(autoincrement())
  ownerName String
  shopName  String
  email     String   @unique
  password  String
  isOpen    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  location String?

  options PrintingOption[]
  orders  Order[]
}

model PrintingOption {
  ownerId Int
  name    String
  value   Decimal @db.Decimal(10, 2)
  owner StationaryOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, name])
}

model Order {
  id          Int         @id @default(autoincrement())
  otp         String
  ownerId     Int
  status      OrderStatus @default(PENDING)
  totalPages  Int
  totalAmount Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner     StationaryOwner @relation(fields: [ownerId], references: [id])
  documents Document[]

  @@index([ownerId, status])
}

model Document {
  id       Int       @id @default(autoincrement())
  orderId  Int
  fileName String
  fileKey  String
  fileSize Int
  pages    Int
  copies   Int       @default(1)
  type     PrintType @default(BW)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum OrderStatus {
  PENDING
  COMPLETED
}

enum PrintType {
  BW
  COLOR
}

enum PaymentMethod {
  ONLINE
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}
